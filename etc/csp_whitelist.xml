<?xml version="1.0"?>
<!--
  Leaflet from unpkg and the OSM tiles it draws - the storefront map and the
  admin point picker both.
-->
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="unpkg" type="host">unpkg.com</value>
            </values>
        </policy>
        <policy id="style-src">
            <values>
                <value id="unpkg" type="host">unpkg.com</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <value id="osm_tiles" type="host">tile.openstreetmap.org</value>
                <value id="unpkg" type="host">unpkg.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
