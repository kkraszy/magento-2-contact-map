<?xml version="1.0"?>
<!-- A group inside core's Stores > Configuration > General > Contacts, under its ACL -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="contact">
            <group id="map" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Map</label>
                <field id="latitude" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Latitude</label>
                    <frontend_class>validate-number validate-number-range number-range--90-90</frontend_class>
                    <comment>Leave latitude and longitude empty to hide the map.</comment>
                </field>
                <field id="longitude" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Longitude</label>
                    <frontend_class>validate-number validate-number-range number-range--180-180</frontend_class>
                </field>
                <field id="picker" translate="label comment" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Point on the map</label>
                    <frontend_model>Kkkonrad\ContactMap\Block\Adminhtml\Picker</frontend_model>
                    <comment>Click the map or drag the marker - it fills in the coordinates above.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
