<?php
/**
 * Shop location on the contact page.
 *
 * Leaflet on OSM tiles, skinned with CSS: tiles in greyscale, the marker and
 * controls in the theme's own `--color-primary` (every Hyvä port defines it;
 * Luma falls back to near-black). Loaded as an ES module, so it neither needs
 * RequireJS (Hyvä has none) nor clashes with it (Luma has it - the UMD build
 * would `define()` itself there instead of returning `L`).
 *
 * Theme-neutral `kk-` classes with their own styles, because Tailwind does not
 * generate classes it only sees in a module.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer
 */

/** @var \Kkkonrad\ContactMap\ViewModel\Map $map */
$map = $block->getData('map');
$point = $map->getPoint();
if (!$point) {
    return;
}
[$lat, $lng] = $point;
$full = sprintf('https://www.openstreetmap.org/?mlat=%1$F&mlon=%2$F#map=17/%1$F/%2$F', $lat, $lng);
?>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
<section class="kk-contact-map">
    <div class="kk-contact-map__frame" id="kk-contact-map" role="region"
         aria-label="<?= $escaper->escapeHtmlAttr(__('Our location on the map')) ?>"></div>
    <a class="kk-contact-map__link" href="<?= $escaper->escapeUrl($full) ?>" target="_blank" rel="noopener">
        <?= $escaper->escapeHtml(__('View larger map')) ?>
    </a>
</section>
<?php
$script = <<<JS
import * as L from 'https://unpkg.com/leaflet@1.9.4/dist/leaflet-src.esm.js';

const point = [$lat, $lng];
const map = L.map('kk-contact-map', {
    // Page scroll and one-finger swipe stay with the page, not the map
    scrollWheelZoom: false,
    dragging: !L.Browser.mobile,
}).setView(point, 16);
L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
}).addTo(map);
L.marker(point, {
    icon: L.divIcon({
        className: 'kk-contact-map__pin',
        html: '<svg viewBox="0 0 32 44" aria-hidden="true"><path d="M16 1C7.7 1 1 7.6 1 15.8 1 27 16 43 16 43s15-16 15-27.2C31 7.6 24.3 1 16 1z"/><circle cx="16" cy="16" r="5.5"/></svg>',
        iconSize: [32, 44],
        iconAnchor: [16, 43],
    }),
    keyboard: false,
}).addTo(map);
JS;
?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', ['type' => 'module'], $script, false) ?>
<style>
    /* em, not rem: Luma's root font-size is 10px (62.5%), Hyvä's is 16px */
    .kk-contact-map {
        --kk-map-accent: var(--color-primary, #111);
        margin: 2em 0;
    }
    /* px: Leaflet sets `font-size: .75rem` on its container, so em here means 12px */
    .kk-contact-map__frame {
        height: 380px;
        border-radius: 12px;
        overflow: hidden;
        background: #f2f2f0;
        z-index: 0; /* Leaflet panes go up to z-index 1000; keep them under the sticky header */
    }
    /* The skin: soft greyscale streets, so only the pin carries colour */
    .kk-contact-map .leaflet-tile-pane {
        filter: grayscale(1) contrast(.9) brightness(1.06);
    }
    .kk-contact-map__pin svg {
        display: block;
        width: 32px;
        height: 44px;
        filter: drop-shadow(0 3px 4px rgb(0 0 0 / .3));
    }
    .kk-contact-map__pin path {
        fill: var(--kk-map-accent);
    }
    .kk-contact-map__pin circle {
        fill: #fff;
    }
    .kk-contact-map .leaflet-bar {
        border: 0;
        border-radius: .5em;
        overflow: hidden;
        box-shadow: 0 2px 8px rgb(0 0 0 / .15);
    }
    .kk-contact-map .leaflet-bar a {
        color: var(--kk-map-accent);
    }
    .kk-contact-map .leaflet-control-attribution {
        background: rgb(255 255 255 / .75);
        font-size: 10px;
    }
    .kk-contact-map__link {
        display: inline-block;
        margin-top: .5em;
        font-size: .875em;
        text-decoration: underline;
    }
</style>
